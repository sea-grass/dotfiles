{
  "inlayHint.enable": true,
  "semanticTokens.enable": true,
  "diagnostic.checkCurrentLine": true,
  "languageserver": {
    "godot": {
      "host": "127.0.0.1",
      "filetypes": ["gdscript"],
      "port": 6008
    },
    "zls": {
      "command": "zls",
      "filetypes": [ "zig", "zon" ]
    },
    "elmLS": {
      "command": "elm-language-server",
      "filetypes": ["elm"],
      "rootPatterns": ["elm.json"]
    }
  },
  "svelte.enable-ts-plugin": true,
  "hover.target": "echo",
  "codeLens.enable": true
}
